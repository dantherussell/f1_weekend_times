<%= form_for [@season, @weekend, @event] do |f| %>
  <% if @event.errors.any? %>
    <div id="errorExplanation">
      <h2><%= pluralize(@event.errors.count, "error") %> prohibited this event from being saved:</h2>

      <ul>
        <% @event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <br>

  <div class="form-group">
    <%= label_tag :series_id, "Series" %>
    <div>
      <%= select_tag :series_id,
            options_from_collection_for_select(@series, :id, :name, @event.session&.series_id),
            include_blank: "Select a series...",
            class: 'form-control',
            id: 'series_select' %>
    </div>
  </div>
  <br>
  <div class="form-group">
    <%= f.label :session_id %>
    <div>
      <%= f.select :session_id, [],
            { include_blank: "Select a session..." },
            { class: 'form-control', id: 'event_session_id', data: { selected: f.object.session_id } } %>
    </div>
  </div>
  <br>
  <div class="form-group">
    Date
    <div>
      <%= f.date_field :start_time_date_field, class: 'form-control' %>
    </div>
    <br>
  </div>
  <div class="form-group">
    <%= f.label :start_time %> in UTC
    <div>
      <%= f.time_field :start_time_time_field, class: 'form-control' %>
    </div>
    <br>
  </div>
  <div class="form-group">
    <%= f.label :local_time_offset %> (e.g. "UTC+1" WITHOUT QUOTES)
    <div>
    <%= f.text_field :local_time_offset, class: 'form-control' %>
    </div>
  </div>
  <br>
  <div class="form-group">
    <%= f.submit %>
  </div>
<% end %>

<br>

<%= link_to 'Back', season_weekend_path(@season, @weekend) %>

<script>
  $(document).ready(function() {
    var $seriesSelect = $('#series_select');
    var $sessionSelect = $('#event_session_id');
    var initialSessionId = $sessionSelect.data('selected');

    function loadSessions(seriesId, selectedSessionId) {
      // Destroy select2 before modifying options
      if ($sessionSelect.hasClass('select2-hidden-accessible')) {
        $sessionSelect.select2('destroy');
      }

      // Clear existing options
      $sessionSelect.empty().append('<option value="">Select a session...</option>');

      if (!seriesId) {
        $sessionSelect.select2();
        return;
      }

      // Fetch sessions for the selected series
      fetch('/series/' + seriesId + '/sessions')
        .then(function(response) { return response.json(); })
        .then(function(sessions) {
          sessions.forEach(function(session) {
            var selected = (session.id == selectedSessionId) ? ' selected' : '';
            $sessionSelect.append('<option value="' + session.id + '"' + selected + '>' + session.name + '</option>');
          });
          $sessionSelect.select2();
        });
    }

    // Load sessions on series change
    $seriesSelect.on('change', function() {
      loadSessions($(this).val(), null);
    });

    // Initial load on page load
    var initialSeriesId = $seriesSelect.val();
    if (initialSeriesId) {
      loadSessions(initialSeriesId, initialSessionId);
    } else {
      $sessionSelect.select2();
    }
  });
</script>
